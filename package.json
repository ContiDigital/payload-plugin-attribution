{
  "name": "payload-plugin-attribution",
  "version": "0.0.0-bootstrap.0",
  "description": "First-party attribution capture and durable conversion delivery to GA4, Google Ads and Meta for Payload CMS",
  "keywords": [
    "payload",
    "payloadcms",
    "plugin",
    "attribution",
    "conversions",
    "ga4",
    "measurement-protocol",
    "google-ads",
    "enhanced-conversions",
    "meta-conversions-api",
    "offline-conversions"
  ],
  "homepage": "https://github.com/ContiDigital/payload-plugin-attribution#readme",
  "bugs": {
    "url": "https://github.com/ContiDigital/payload-plugin-attribution/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ContiDigital/payload-plugin-attribution.git"
  },
  "license": "MIT",
  "author": "Conti Digital",
  "packageManager": "pnpm@11.0.9",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/exports/client.d.ts",
      "import": "./dist/exports/client.js",
      "default": "./dist/exports/client.js"
    },
    "./next": {
      "types": "./dist/exports/next.d.ts",
      "import": "./dist/exports/next.js",
      "default": "./dist/exports/next.js"
    },
    "./browser": {
      "types": "./dist/exports/browser.d.ts",
      "import": "./dist/exports/browser.js",
      "default": "./dist/exports/browser.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && swc ./src -d ./dist --config-file .swcrc --strip-leading-paths --ignore \"**/__tests__/**\" --ignore \"**/*.test.*\"",
    "clean": "rimraf dist coverage",
    "dev": "next dev dev --webpack",
    "dev:e2e": "ATTRIBUTION_SEED=true tsx dev/e2e-bootstrap.ts && next dev dev --webpack --hostname 127.0.0.1 --port ${PLAYWRIGHT_PORT:-3198}",
    "dev:e2e:start": "ATTRIBUTION_SEED=true tsx dev/e2e-bootstrap.ts && next build dev --webpack && next start dev --hostname 127.0.0.1 --port ${PLAYWRIGHT_PORT:-3198}",
    "dev:mock-providers": "tsx dev/mockProviders.ts",
    "dev:payload": "PAYLOAD_CONFIG_PATH=dev/payload.config.ts payload",
    "generate:importmap": "pnpm dev:payload generate:importmap && prettier --write 'dev/app/(payload)/admin/importMap.js'",
    "generate:types": "pnpm dev:payload generate:types",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint src dev --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:live": "vitest run --config vitest.live.config.ts",
    "check:repository": "node scripts/check-repository.mjs",
    "package:check": "publint && attw --pack . --profile esm-only",
    "pack:smoke": "bash ./scripts/pack-smoke.sh",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "prepack": "pnpm build",
    "release:check": "pnpm check:repository && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm pack:smoke && pnpm package:check && pnpm audit:prod"
  },
  "dependencies": {
    "google-auth-library": "^10.9.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.13.0",
    "@payloadcms/db-mongodb": "3.89.0",
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/db-sqlite": "3.89.0",
    "@payloadcms/eslint-config": "3.28.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/ui": "3.89.0",
    "@playwright/test": "1.63.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "^1.16.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.9",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.0",
    "eslint": "^9.23.0",
    "graphql": "^16.8.1",
    "jsdom": "30.0.1",
    "next": "16.3.5",
    "payload": "3.89.0",
    "prettier": "^3.9.6",
    "publint": "0.3.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rimraf": "6.1.3",
    "tsx": "^4.20.0",
    "typescript": "5.6.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@payloadcms/ui": "^3.84.1",
    "next": ">=15.2.9 <17",
    "payload": "^3.84.1",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@payloadcms/ui": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "payload": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
