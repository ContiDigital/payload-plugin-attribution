ATTRIBUTION_DISABLED=false
ATTRIBUTION_RUN_JOBS=false
ATTRIBUTION_SEED=false
ATTRIBUTION_SECRET=replace-with-a-stable-local-secret
# A postgres:// URL runs the harness on Postgres; the default is file:./dev/attribution.db.
# DATABASE_URL=
# GA4 Admin API credentials for the development CLI:
# pnpm dev:payload run dev/scripts/attribution.ts -- setup-ga4 --plan dev/fixtures/ga4-plan.json
# GOOGLE_SERVICE_ACCOUNT_JSON=
# payload-jobs (default) or outbox, which queues deliveries in the demo outbox collection.
ATTRIBUTION_DISPATCHER=payload-jobs
# Point every destination at the local mock providers (pnpm dev:mock-providers) instead of
# leaving destinations unconfigured. Never point the harness at live credentials.
# ATTRIBUTION_MOCK_PROVIDERS_URL=http://127.0.0.1:3199

# Live validation (pnpm test:live). Each group runs only when all of its variables are set, and only
# sends validation requests: GA4 debug validation, Data Manager validateOnly, Meta test events.
# ATTRIBUTION_LIVE_GA4_MEASUREMENT_ID=
# ATTRIBUTION_LIVE_GA4_API_SECRET=
# ATTRIBUTION_LIVE_GOOGLE_ADS_OPERATING_ACCOUNT_ID=
# ATTRIBUTION_LIVE_GOOGLE_ADS_LOGIN_ACCOUNT_ID=
# ATTRIBUTION_LIVE_GOOGLE_ADS_CONVERSION_ACTION_ID=
# ATTRIBUTION_LIVE_GOOGLE_ADS_SERVICE_ACCOUNT_JSON=
# ATTRIBUTION_LIVE_META_PIXEL_ID=
# ATTRIBUTION_LIVE_META_ACCESS_TOKEN=
# ATTRIBUTION_LIVE_META_TEST_EVENT_CODE=
