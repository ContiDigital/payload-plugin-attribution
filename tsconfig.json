{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "payload-plugin-attribution": ["src/index.ts"],
      "payload-plugin-attribution/client": ["src/exports/client.ts"],
      "payload-plugin-attribution/next": ["src/exports/next.ts"],
      "payload-plugin-attribution/browser": ["src/exports/browser.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "dev/**/*.ts", "dev/**/*.tsx"],
  "exclude": ["**/dist", "**/node_modules", "dev/.next"]
}
